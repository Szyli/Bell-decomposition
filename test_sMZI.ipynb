    "data_group = []\n",
    "\n",
    "g1 = gradient(widths[0], upper_wg_top_width, l1)\n",
    "for w in widths:\n",
    "    # I. Prepare taper data\n",
    "    l = (w-upper_wg_top_width)/g1\n",
    "    taper_data: dict = {\n",
    "        \"width\" : w,\n",
    "        \"length\" : l\n",
    "    }\n",
    "    geometries = sim.GeometryHolder(lower_wg_height,upper_wg_height,upper_wg_top_width,\n",
    "            base_angle,triplex_dist,s_bend_height,s_bend_length,coupling_gap,\n",
    "            connector_length,wg_material,cover_material, mode=2,\n",
    "            mmi_taper_length=taper_data[\"length\"],\n",
    "            taper_width=taper_data[\"width\"])\n",
    "    # II: Build the objects\n",
    "    if not isinstance(coupling_gap, int):\n",
    "        c_gap = str(coupling_gap).replace('.','_')\n",
    "    else:\n",
    "        c_gap = coupling_gap\n",
    "\n",
    "    mmi_name = source+\"g\"+str(c_gap)+\"_mmi\"+str(w)\n",
    "    sim.mmi_coupler_builder(geometries.lower_wg, geometries.upper_wg,\n",
    "                            triplex_dist,\n",
    "                            geometries.insulation,\n",
    "                            insul_height_bot, insul_height_top,\n",
    "                            1, 2,\n",
    "                            mmi_name, \"MODE\",\n",
    "                            layout_extract=False, hideAnsys=True)\n",
    "    # III. Adjust to simulation\n",
    "    script = \"load('\"+mmi_name+\".fsp');\\n\"\n",
    "    script += deletion_script\n",
    "    # IV. evaluate simulation\n",
    "    name = \"g\"+str(c_gap)+\"_w\"+str(w)\n",
    "    # nsteps1 = np.linspace(l, l**2, num=int(l), endpoint=True)\n",
    "    # nsteps2 = np.linspace(l**2+l, 2*(l**2), num=3, endpoint=True)\n",
    "    # nsteps = [str(int(step1)) for step1 in nsteps1]\n",
    "    # nsteps.extend([str(int(step2)) for step2 in nsteps2])\n",
    "    nsteps1 = np.linspace(int(l), 5*int(l), num=5, endpoint=True)\n",
    "    nsteps2 = np.linspace(5*int(l)+int(l), 10*(int(l)), num=3, endpoint=True)\n",
    "    nsteps = [str(int(step1)) for step1 in nsteps1]\n",
    "    nsteps.extend([str(int(step2)) for step2 in nsteps2])\n",
    "    nsteps = ','.join(nsteps)\n",
    "    file_name = \"results/data/\"\n",
    "\n",
    "    script += \"name='\"+name+\"';\\n\"\\\n",
    "            \"l_tpr = [\"+str(l)+\"];\\n\"\\\n",
    "            \"N = [\"+nsteps+\"];\\n\"\\\n",
    "            \"top_tpr_w = \"+str(w)+\";\\n\"\\\n",
