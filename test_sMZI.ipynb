      "\n",
      "\tCross mode data\n",
      "Fitted params and their errors:\n",
      "[a\tb]\n",
      "[ 0.00957603 -0.24892846]\n",
      "[5.05523738e-05 3.87629122e-03]\n"
     ]
    }
   ],
   "source": [
    "# bar mode\n",
    "popt_bar, pcov_bar = curve_fit(linear, lens-200, bar_t)\n",
    "perr_bar = np.sqrt(np.diag(pcov_bar))\n",
    "print(\"\\tBar mode data\")\n",
    "print(\"Fitted params and their errors:\\n[a\\tb]\")\n",
    "print(popt_bar)\n",
    "print(perr_bar)\n",
    "# cross mode\n",
    "popt_cross, pcov_cross = curve_fit(linear, lens-200, cross_t)\n",
    "perr_cross = np.sqrt(np.diag(pcov_cross))\n",
    "print(\"\\n\\tCross mode data\")\n",
    "print(\"Fitted params and their errors:\\n[a\\tb]\")\n",
    "print(popt_cross)\n",
    "print(perr_cross)"
   ]
