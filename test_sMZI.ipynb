  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Coupling optimalization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def data_reader(fname: str, dim_g: int, dim_l: int,\n",
    "                source: str = \"simulations/82_coupling_region/\") -> tuple[np.ndarray, np.ndarray, np.ndarray]:\n",
    "    \"\"\"\n",
    "    Every line is for one gap; every column is for one length.\n",
    "    \"\"\"\n",
    "    with open(source+fname, 'r') as file:\n",
    "        raw_data = [line.rstrip('\\n') for line in file]\n",
    "\n",
    "    gaps = np.array(raw_data[3:3+dim_g],dtype=float) # measured data\n",
    "    lens = np.array(raw_data[3+dim_g+2:3+dim_g+2+dim_l],dtype=float)\n",
    "    data = np.ndarray((dim_g, dim_l), dtype=float)\n",
    "    # channels, time, counts\n",
    "\n",
    "    idx = 0\n",
    "    for row in raw_data[3+dim_g+2+dim_l+2:3+2*dim_g+2+dim_l+2]:\n",
    "        data_str = row.split()\n",
    "        data[idx] = np.array(data_str,dtype=float)\n",
    "        idx += 1\n",
    "    \n",
    "    return gaps, lens, data\n",
    "\n",
    "def length_data_reader(fname: str, dim: int, start: int = 3,\n",
    "                source: str = \"simulations/82_coupling_region/\") -> tuple[np.ndarray, np.ndarray, np.ndarray]:\n",
    "    \"\"\"\n",
    "    Reads only from a single length sweep.\n",
    "    \"\"\"\n",
    "    with open(source+fname, 'r') as file:\n",
    "        raw_data = [line.rstrip('\\n') for line in file]\n",
    "\n",
    "    lens = np.array([], dtype=float)\n",
    "    raw_1 = np.array([], dtype=float)\n",
    "    raw_2 = np.array([], dtype=float)\n",
    "    for row in range(start,dim+start):\n",
    "        temp = raw_data[row].split(',')\n",
    "        lens = np.append(lens, float(temp[0]))\n",
    "        raw_1 = np.append(raw_1, float(temp[1]))\n",
    "        raw_2 = np.append(raw_2, float(raw_data[row+dim+4].split(',')[1]))\n",
    "\n",
    "    # norm = np.copy(raw_1)\n",
    "    # norm = np.append(norm,raw_2)\n",
    "    # norm = norm.max()\n",
    "    norm=1\n",
    "    data_1 = raw_1/norm\n",
    "    data_2 = raw_2/norm\n",
    "    \n",
    "    return lens, data_1, data_2\n",
    "    \n",
    "def sub_plotter(x: np.array, gap: np.array,\n",
    "                data_0: np.ndarray, data_1: np.ndarray,\n",
    "                dim: int, trans: bool = True) -> None:\n",
    "\n",
    "    fig = plt.figure(figsize=(10,6*dim))\n",
    "    fig.subplots_adjust(hspace=0.35)\n",
    "    ax = fig.subplots(dim, 1)\n",
    "\n",
    "    if trans:\n",
    "        y_labs = np.arange(0,11,1, dtype=float)\n",
    "        y_labs = y_labs/10\n",
    "    else:\n",
    "        y_labs = np.linspace(min([data_0.min(), data_1.min()]), max([data_0.max(), data_1.max()]),10, dtype=float)\n",
    "        y_labs_text = np.array(y_labs,dtype=str)\n",
    "        # y_labs = y_labs*1e-15\n",
    "\n",
    "    for idx in range(len(gap)):\n",
    "        ax[idx].plot(x, data_0[idx], marker='o', ms=6, c=\"orange\", mec = \"black\")\n",
    "        ax[idx].plot(x, data_1[idx], marker='o', ms=6, c=\"red\", mec = \"black\")\n",
    "        if trans:\n",
    "            ax[idx].plot(x, [0.5]*len(x), color=\"green\")\n",
    "\n",
    "        ax[idx].set_title(r\"coupling gap = {:.2f} $\\mu m$\".format(gap[idx]), fontsize=16)\n",
    "        ax[idx].set_xticks(x, x.astype(int), fontsize=16)\n",
    "        if trans:\n",
    "            ax[idx].set_yticks(y_labs, y_labs, fontsize=16)\n",
    "        else:\n",
    "            ax[idx].set_yticks(y_labs, y_labs_text, fontsize=16)\n",
    "\n",
    "        ax[idx].set_xlabel(r\"Coupling length [$\\mu$m]\", fontsize=16)\n",
    "        if trans:\n",
    "            ax[idx].set_ylabel(\"Transmission\", fontsize=16)\n",
    "        else:\n",
    "            ax[idx].set_ylabel(\"Power\", fontsize=16)\n",
    "\n",
    "        ax[idx].legend([\"bar mode\", \"cross mode\", \"50:50\"], fontsize=16,loc=1)\n",
    "        ax[idx].grid(True)\n",
    "\n"
   ]
