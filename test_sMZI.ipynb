   "source": [
    "def powcalc(phase: np.ndarray | float, a:float, b:float)->np.ndarray |float:\n",
    "    \"\"\"\n",
    "    Function to compute power from given phase. It's simply the rearranged form of the fitted linear function.\n",
    "    \"\"\"\n",
    "    return (phase-b)/a\n",
    "\n",
    "# let's say I need a pi-phase shift\n",
    "aim_phase = np.pi\n",
    "nec_pow = powcalc(aim_phase,*popt)\n",
    "print(\"Necessary power for {:.4f} phase shift is\\t{:.4f} [W]\".format(aim_phase, nec_pow))\n",
    "\n",
    "\n",
    "fine_x = np.linspace(ps_2[0,0],ps_2[-1,0], 100)\n",
    "\n",
    "plt.figure(figsize=(12,6))\n",
    "\n",
    "plt.plot(ps_2[:,0], ps_2[:,1], marker=\"o\", ls='dotted', color=\"blue\", ms=6)\n",
    "plt.plot(fine_x, linear(fine_x, *popt), color=\"green\", alpha=0.4, lw=3)\n",
    "\n",
    "plt.plot(nec_pow,aim_phase, marker='x', ms=12, color=\"magenta\")\n",
    "\n",
    "plt.plot(ps_0[:,0], [np.pi]*len(ps_0[:,0]), color=\"black\")\n",
    "plt.plot(ps_0[:,0], [2*np.pi]*len(ps_0[:,0]), color=\"black\")\n",
    "plt.fill_between(pow_lim_x, pow_lim_y1, pow_lim_y2, alpha=0.4, color=\"red\")\n",
    "\n",
    "plt.grid(True)\n",
    "plt.legend([r\"simulation\", r\"linear fit\", r\"aimed phase\",\n",
    "            r\"$\\pi$-shift\", r\"2$\\pi$-shift\", \"power limit\"])\n",
    "\n",
    "plt.xlabel(\"Power [W]\")\n",
    "plt.ylabel(\"Phase shift\")\n",
    "plt.title(\"Deep trenched phase shift simulation and fitted linear function\")"
   ]
