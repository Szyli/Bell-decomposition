    ">### MMI loss calculation automation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 287,
   "metadata": {},
   "outputs": [],
   "source": [
    "import optics_simulator as sim\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.optimize import curve_fit\n",
    "\n",
    "def gradient(tpr_width, wg_width, tpr_length):\n",
    "    return (tpr_width - wg_width)/tpr_length\n",
    "\n",
    "def reciproc(x: np.ndarray | float,\n",
    "            a: float, b: float,\n",
    "            c: float) -> np.ndarray | float:\n",
    "    \"\"\"\n",
    "    Function to compute the reciprocal function in the form:\n",
    "    \n",
    "    >>``a/(b*x + c} + d``\n",
    "    \n",
    "    \"\"\"\n",
    "    return a/(x + b) +c\n",
    "\n",
    "def power_law(x: np.ndarray |float,\n",
    "            a: float, b: float,\n",
    "            c: float) -> np.ndarray | float:\n",
    "    \"\"\"\n",
    "    Function to compute the power-law function in the form:\n",
    "    \n",
    "    >>``a*(x^-b} + d``\n",
    "    \n",
    "    \"\"\"\n",
    "    return a / (x**b) +c\n",
    "\n",
    "def expdec(x: np.ndarray | float,\n",
    "            a: float, b: float,\n",
    "            c: float, d: float) -> np.ndarray | float:\n",
    "    \"\"\"\n",
    "    Function to compute the decaying exponential function in the form:\n",
    "    \n",
    "    >>``a*e^{-x*b + c} + d``\n",
    "    \n",
    "    \"\"\"\n",
    "    return a * np.exp(-b * x) + c * x + d\n",
    "    # return a * np.exp(-x/b)**c + d/(x+e)**f\n",
    "\n",
    "def data_reader(fname: str,\n",
    "                source = \"simulations/MMI/our_design/MMI_opt/limit_test/mismatches/gap_2/\") -> np.ndarray:\n",
    "    \n",
    "    with open(source+fname, 'r') as file:\n",
    "        raw_lines = [line.rstrip('\\n') for line in file]\n",
    "        raw_data = [col.split('\\t') for col in raw_lines]\n",
    "\n",
    "    n_points = len(raw_data)        # the rows in the file\n",
    "    n_data = len(raw_data[0])       # the columns in the file\n",
    "\n",
    "    data = np.zeros(shape=(n_points,n_data), dtype=float)\n",
    "\n",
    "    for row in range(n_points):\n",
    "        data[row] = raw_data[row]\n",
    "\n",
    "    return data\n",
    "\n",
    "def plot_n_fit(data: np.ndarray|np.ndarray, legval: str|list[str], leglab: str,\n",
    "               n_in: int = 0,\n",
    "               bounds: tuple = (-np.inf, np.inf),\n",
    "               p0: list = None,\n",
    "               xlabel: str=r\"taper length [$\\mu$m]\",\n",
    "               ylabel: str=\"loss [dB]\",\n",
    "               tit: str=\"mode mismathc of different taper designs\",\n",
    "               fitfunc: int = 0,\n",
    "               error_in_db: bool = False,\n",
    "               leg_as: bool = True) -> tuple[list, list, list]:\n",
    "\n",
    "    if not n_in:    # if there is only one set of data as input\n",
    "        fine_points = np.linspace(data[0,0], 2*data[-1,0], 10*int(max(data[:,0])))\n",
    "        n_rows = len(data[:,0])\n",
    "        if fitfunc == 0:\n",
    "            popt, pcov = curve_fit(reciproc, data[:,0], data[:,1], bounds=bounds)\n",
    "            perr = np.sqrt(np.diag(pcov))\n",
    "            func_points = reciproc(fine_points, *popt)\n",
    "\n",
    "        elif fitfunc == 1:\n",
    "            popt, pcov = curve_fit(power_law, data[:,0], data[:,1], bounds=bounds)\n",
    "            perr = np.sqrt(np.diag(pcov))\n",
    "            func_points = power_law(fine_points, *popt)\n",
    "\n",
    "        elif fitfunc == 2:\n",
    "            popt, pcov = curve_fit(expdec, data[:,0], data[:,1], bounds=bounds)\n",
    "            perr = np.sqrt(np.diag(pcov))\n",
    "            func_points = expdec(fine_points, *popt)\n",
    "        asymptote = popt[-1]\n",
    "        # -----------------------------\n",
    "        # PLOT\n",
    "        # -----------------------------\n",
    "\n",
    "        if not error_in_db: #change into percentages\n",
    "            func_points = (1-(10**(-func_points/10)))*100\n",
    "            data[:,1] = (1-(10**(-data[:,1]/10)))*100\n",
    "            asymptote = float(1-(10**(-asymptote/10)))*100\n",
    "\n",
    "        plt.figure(figsize=(10,6))\n",
    "        colors = plt.rcParams[\"axes.prop_cycle\"].by_key()[\"color\"]\n",
    "        color = colors[0]\n",
    "        plt.plot(data[:,0], data[:,1], ls='', marker='o', color=color)\n",
    "        plt.plot(fine_points, func_points, color=color)\n",
    "        plt.plot(fine_points, [asymptote]*len(fine_points), ls='dotted', color='black')\n",
    "        plt.text(fine_points[0], asymptote+(min(data[-1,:])-asymptote)/4, \"{:.6f}\".format(asymptote), color='black')\n",
    "\n",
    "\n",
    "        plt.title(tit, fontsize=12)\n",
    "        plt.legend([f\"{leglab}\"+r\"={}$\\mu$m\".format(legval), \"fitted function\", \"asymptote\"], fontsize=12)\n",
    "        plt.xlabel(xlabel, fontsize=12)\n",
    "        plt.ylabel(ylabel, fontsize=12)\n",
    "        plt.grid(True)\n",
    "\n",
    "        return popt, perr, asymptote\n",
    "    # -----------------------------\n",
    "    # there are more inputs\n",
    "    # -----------------------------\n",
    "    else:\n",
    "        fit_params = []\n",
    "        fit_errors = []\n",
    "        asymptotes = []\n",
    "        func_points = []\n",
    "\n",
    "        n_rows = np.array([max(elem[:,0]) for elem in data])\n",
    "        longest = np.where(n_rows == max(n_rows))[0][0]     # longest dataset\n",
    "        shortest = np.where(n_rows == min(n_rows))[0][0]\n",
    "        fine_points = np.linspace(data[shortest][0,0], 2*data[longest][-1,0], 10*int(max(n_rows)))\n",
    "\n",
    "        for elem in data:\n",
    "            if fitfunc == 0:\n",
    "                popt, pcov = curve_fit(reciproc, elem[:,0], elem[:,1], bounds=bounds)\n",
    "                perr = np.sqrt(np.diag(pcov))\n",
    "                fit_params.append(popt)\n",
    "                fit_errors.append(perr)\n",
    "                asymptotes.append(popt[-1])\n",
    "                func_points.append(reciproc(fine_points, *popt))\n",
    "\n",
    "            elif fitfunc == 1:\n",
    "                popt, pcov = curve_fit(power_law, elem[:,0], elem[:,1], bounds=bounds)\n",
    "                perr = np.sqrt(np.diag(pcov))\n",
    "                fit_params.append(popt)\n",
    "                fit_errors.append(perr)\n",
    "                # asymptotes.append(popt[-1])\n",
    "                asymptotes.append(power_law(1e10,*popt))\n",
    "                func_points.append(power_law(fine_points, *popt))\n",
    "\n",
    "            elif fitfunc == 2:\n",
    "                popt, pcov = curve_fit(expdec, elem[:,0], elem[:,1], bounds=bounds, p0=p0)\n",
    "                perr = np.sqrt(np.diag(pcov))\n",
    "                fit_params.append(popt)\n",
    "                fit_errors.append(perr)\n",
    "                asymptotes.append(popt[-1])\n",
    "                func_points.append(expdec(fine_points, *popt))\n",
    "        # -----------------------------\n",
    "        # PLOT\n",
    "        # -----------------------------\n",
    "        \n",
    "        for i in range(len(fit_params)):\n",
    "            if not error_in_db: #change into percentages\n",
    "                func_points[i] = (1-(10**(-func_points[i]/10)))*100\n",
    "                data[i][:,1] = (1-(10**(-data[i][:,1]/10)))*100\n",
    "        if not error_in_db: # can't do this in the for loop above\n",
    "            asymptotes = [float(1-(10**(-a/10)))*100 for a in asymptotes]\n",
    "\n",
    "        plt.figure(figsize=(12,8))\n",
    "        colors = plt.rcParams[\"axes.prop_cycle\"].by_key()[\"color\"]\n",
    "        lgnd=[]\n",
    "        for i in range(len(func_points)):\n",
    "            color=colors[i]\n",
    "            lgnd.append(f\"{leglab}\"+r\"={}$\\mu$m\".format(legval[i]))\n",
    "            plt.plot(data[i][:,0], data[i][:,1], ls='', marker='o', color=color)\n",
    "            plt.plot(fine_points, func_points[i], color=color)\n",
    "            if leg_as:\n",
    "                lgnd.append('_')\n",
    "                lgnd.append('_')\n",
    "                plt.plot(fine_points, [asymptotes[i]]*len(fine_points), ls='dotted', color='black')\n",
    "                plt.text(fine_points[0], asymptotes[i]+(min(data[i][-1,:])-asymptotes[i])/4, \"{:.6f}\".format(asymptotes[i]), color='black')\n",
    "        \n",
    "        # lgnd[-2] = 'fitted functions'\n",
    "        if leg_as:\n",
    "            lgnd[-1] = 'asymptotes'\n",
    "        plt.title(tit, fontsize=12)\n",
    "        plt.legend(lgnd, fontsize=12)\n",
    "        plt.xlabel(xlabel, fontsize=12)\n",
    "        plt.ylabel(ylabel, fontsize=12)\n",
    "        plt.grid(True)\n",
    "\n",
    "        return fit_params, fit_errors, asymptotes\n"
   ]
  },
