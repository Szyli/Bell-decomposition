  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "from scipy.optimize import curve_fit\n",
    "\n",
    "def linear(x: np.ndarray | float, a: float, b: float) -> np.ndarray | float:\n",
    "    \"\"\"\n",
    "    In this contaxt the parameters are the following physical values.\n",
    "\n",
    "    ---\n",
    "\n",
    "    Args:\n",
    "        x (array | float): The electric power in Watts\n",
    "        a (float): steepness of linear curve\n",
    "        b (float): displacement of linear curve\n",
    "\n",
    "    Returns:\n",
    "        The phase shift value at given `x`.\n",
    "    \"\"\"\n",
    "    return a*x +b"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[ 4.1247210e+01 -1.6869006e-02] [0.10649043 0.01992256]\n"
     ]
    }
   ],
   "source": [
    "popt, pcov = curve_fit(linear, ps_2[:,0], ps_2[:,1])\n",
    "perr = np.sqrt(np.diag(pcov))\n",
    "print(popt, perr)"
   ]
  },
