   "source": [
    "diff = 1\n",
    "tol_diff = 1e-4\n",
    "num = 20\n",
    "step = 10\n",
    "lim = 0\n",
    "while (abs(diff) > tol_diff) or (lim > 10):\n",
    "    lim += 1\n",
    "\n",
    "    fine_lens = np.linspace(lens[lim_bot]-200, lens[lim_top-1]-200, num)\n",
    "    fit_bar = linear(fine_lens, *popt_bar)\n",
    "    fit_cross = linear(fine_lens, *popt_cross)\n",
    "\n",
    "    diff = abs(fit_cross-fit_bar)\n",
    "    coupling_length = fine_lens[np.where(diff == min(diff))]\n",
    "    diff = min(diff)\n",
    "    \n",
    "\n",
    "    num += step\n",
    "    print(\"Iteration:\\t{}\".format(lim))\n",
    "    print(\"Difference of the two transmission:\\t{:4f}\".format(diff))\n",
    "print(\"Found coupling length:\\t{:.4f} um\".format(*coupling_length))"
   ]
