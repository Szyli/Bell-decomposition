switchtolayout;

L = 200e-6;
lambda = 1.55e-6;

dist = [2,4,6,8,10]*1e-6;

#folder_name = "wire_trench_pos_results/wider/";
folder_name = "proposition/trench_pos_sweep/";

select("trench_pos");
orig_pos = get("y");
trench_w = get("y span");

wire_edge = 4e-6;

disloc = wire_edge/2 + trench_w/2;


power = [0, 0.05, 0.1, 0.15, 0.2, 0.25];
neff = matrix(length(power));

# find neff with no heating
setnamed('temperature','enabled',0);
setanalysis('wavelength',lambda);
findmodes;
neff0 = real(getdata('mode1','neff'));
loss0 = real(getdata('mode1','loss'));
neff(1) = neff0;

for(y=1:length(dist)){
    switchtolayout;
    
    select("trench_pos");
    set("y",disloc+dist(y));
    select("trench_neg");
    set("y",-disloc-dist(y));
    
    T_name = "T3_trench_pos_"+
            replacestring(num2str(dist(y)*1e6),".","_");
    # import T map
    select('temperature');
    importdataset(folder_name+T_name+".mat");

    for(i=2:length(power)){
        switchtolayout;
        setnamed('temperature','enabled',1);
        setnamed('temperature','P_index',i-1);
        findmodes;
        neff(i) = real(getdata('mode1','neff'));
    }
    # phase shift
    phase = 2*pi*(neff-neff0)*L/lambda;
    
    # save results       
    results = matrix(length(power),2);
    results(:,1) = power;
    results(:,2) = phase;
    write(folder_name+"power_phase_points_"+
            replacestring(num2str(dist(y)*1e6),".","_")+".txt",
            num2str(results), "overwrite");
    plot(power, phase, 'Power (W)','Phase shift','Phase-power relationship',
        "color=blue");
    holdon;
    plot(power, phase, "Power (W)", "Phase shift", "Phase-power relationship",
        "marker style=x, plot points, color=blue");
    holdon;
}

Vpi = matrix(1,length(power)); # array of zeros
Vpi = Vpi+pi;
plot(power, Vpi);
holdon;
plot(power, 2*Vpi);
holdoff;
legend("",
       "Simulation",
       "Pi shift","2Pi shift");

switchtolayout;
select("trench_pos");
set("y",orig_pos);
select("trench_neg");
set("y",-orig_pos);
