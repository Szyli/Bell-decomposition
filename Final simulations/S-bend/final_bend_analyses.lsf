# exporting mode profile from cross section monitor
name = "mode_comp_raw_data/straight_";
#name = "mode_comp_raw_data/out_Sbend_";

# Get 2D slice of the data
E_2D = pinch(pic.E,1,component);    # Remove component dimension
E_2D = pinch(E_2D,3,wavelength_index); # Remove wavelength dimension

# Export each component to separate files
write(name+"Ex.txt", num2str(abs(pinch(E_2D,3,1))),"overwrite");  # Ex component
write(name+"Ey.txt", num2str(abs(pinch(E_2D,3,2))),"overwrite");  # Ey component
write(name+"Ez.txt", num2str(abs(pinch(E_2D,3,3))),"overwrite");  # Ez component

# Export coordinates (assuming they match E_2D dimensions)
write(name+"z_coords.txt", num2str(pic.z),"overwrite");
write(name+"y_coords.txt", num2str(pic.y),"overwrite");
