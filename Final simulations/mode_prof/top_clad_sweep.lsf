switchtolayout;
clad_heights = [1, 2, 3]*1e-6;
N = length(clad_heights);

neff = matrix(N);
losses = matrix(N);
group_idx = matrix(N);
Dname = cell(N);

name=pwd;    # gives location of simulation file
name = name + "/mode_profiles/";
wavelength_index = 1;  # First wavelength point
component = 1;         # 1=Ex, 2=Ey, 3=Ez


select("covering::top insulation::insulator_2");
z_min = get("z min");

for(i=1:N){
    switchtolayout;
    H = clad_heights(i);
    Dname{i} = "h_"+num2str(H*1e6);
    select("covering::top insulation::insulator_2");
    set("z max", z_min + H);
    
    findmodes;
    neff(i) = real(getdata("mode1","neff"));
    losses(i) = real(getdata("mode1","loss"));    
    group_idx(i) = real(getdata("mode1","ng"));
    copydcard("mode1", Dname{i});
    
    pic = getresult("FDE::data::mode1","E");

    # Get 2D slice of the data
    E_2D = pinch(pic.E,1,component);    # Remove component dimension
    E_2D = pinch(E_2D,3,wavelength_index); # Remove wavelength dimension
    
    # Export each component to separate files
    write(name+num2str(clad_heights(i)*1e6)+"_Ex.txt", num2str(abs(pinch(E_2D,3,1))),"overwrite");  # Ex component
    write(name+num2str(clad_heights(i)*1e6)+"_Ey.txt", num2str(abs(pinch(E_2D,3,2))),"overwrite");  # Ey component
    write(name+num2str(clad_heights(i)*1e6)+"_Ez.txt", num2str(abs(pinch(E_2D,3,3))),"overwrite");  # Ez component
    
    # Export coordinates (assuming they match E_2D dimensions)
    write(name+num2str(clad_heights(i)*1e6)+"_z_coords.txt", num2str(pic.z),"overwrite");
    write(name+num2str(clad_heights(i)*1e6)+"_y_coords.txt", num2str(pic.y),"overwrite");
    
}
# turn into dB/cm
losses = losses/100;

overlaps = matrix(N, N);
for(i=1:N){
    for(j=i:N){
        ovrlp = overlap(Dname{i}, Dname{j});
        overlaps(i,j) = ovrlp(1);
        overlaps(j,i) = ovrlp(1);
    }
}

write("overlaps.txt", num2str(overlaps), "overwrite");
write("neffs.txt", num2str(neff), "overwrite");
write("losses.txt", num2str(losses), "overwrite");
write("group_idx.txt", num2str(group_idx), "overwrite");

# clear all dcard copies
cleardcard();



